
{
  "expo": {
    "name": "Hecto",
    "slug": "hecto",
    "scheme": "hecto",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hecto needs your photos to make stencils.",
          "cameraPermission": "Hecto uses the camera for references and Try On."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "backgroundColor": "#121212"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hecto.app"
    },
    "android": {
      "package": "com.hecto.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#121212"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0c378a1f-1e7a-4918-acf6-27a4b62e2c56"
      }
    },
    "owner": "hecto_app"
  }
}
